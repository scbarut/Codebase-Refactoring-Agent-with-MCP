# ==============================================================================
# Autonomous Codebase Refactoring & Migration Agent — Environment Configuration
# Copy this file to .env and provide your secret credentials.
# ==============================================================================

# Primary LLM API Key (Default is Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative LLM Provider Keys (Optional: if configured in config.yaml via LiteLLM)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OLLAMA_API_BASE=http://localhost:11434


# PostgreSQL connection URL for LangGraph checkpointer
# Default matches docker-compose postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/migration_agent

# LangSmith Tracing (Optional: set to enable graph & LLM tracing)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=migration-agent
LANGSMITH_TRACING=false

# Tavily API Key (Optional: for lightweight doc retrieval web fallback)
TAVILY_API_KEY=
